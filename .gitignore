
# FBX-embedded media unpack folders (importer side effect, never source)
art/**/*.fbm/

# Blender/Python bytecode + autosaves from the art scripts -- noise in every art commit
__pycache__/
*.pyc
*.blend1

# build.ps1 gate 4a2 stale-relink stamp -- machine-local build state, never source
tools/.build-source-hash

# WIP art (Tripo candidates, retopo, masks) -- 2.2 GB, kept on disk only; full pre-strip history in _archive/PrimalFauna-pre-art-strip-2026-10-13.bundle
art/wip/

# WIP sandworm art (Tripo candidates, retopo, textures, probe logs) -- 5.2 GB, never committed, kept on disk only; full tree parked in _archive/PrimalFauna-art-sandworm-2026-10-27.bundle (same policy as art/wip)
art/sandworm/

# graphify knowledge-graph output -- derived, regenerated by the post-commit hook; the unified vault merges from the on-disk graph.json
graphify-out/
